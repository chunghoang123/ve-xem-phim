# NVIDIA NIM (server only - never expose this key in frontend code)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_TIMEOUT_MS=45000

# TMDB movie data (refreshed at server startup and every 12 hours)
TMDB_API_KEY=your-tmdb-key-here
TMDB_SYNC_ENABLED=true
TMDB_SYNC_INTERVAL_HOURS=12
TMDB_SYNC_PAGES=1
TMDB_SYNC_TYPES=upcoming,now_playing,popular

# YouTube Data API v3 (fills missing trailers during each TMDB sync)
YOUTUBE_API_KEY=your-youtube-data-api-key-here
YOUTUBE_TRAILER_SYNC_LIMIT=50

# Automatically allocate safe, unbooked showtimes to newly synced movies
AUTO_SHOWTIME_DAYS_AHEAD=7
AUTO_SHOWTIME_MOVIE_LIMIT=20

# Application
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# MySQL (local names; Railway MYSQL* variables are also supported automatically)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password
DB_NAME=cinex

# PayOS
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# Firebase client configuration (embedded in the frontend build)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Firebase Admin / social login (server only)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CLIENT_ID=your-google-oauth-client-id
